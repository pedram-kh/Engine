VITE_APP_NAME="Catalyst Engine"
VITE_API_BASE_URL=/api/v1
VITE_SENTRY_DSN_MAIN=
# Optional: the default is support@catalyst-growth.com (src/core/config/support.ts). The API reads SUPPORT_EMAIL.
VITE_SUPPORT_EMAIL=support@catalyst-growth.com
# Build-time only, set in the Netlify site env (never VITE_-prefixed, never in the bundle). With no token the
# build emits no source maps. SENTRY_RELEASE is an override: the release name is derived from git tree hashes.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_URL=
# SENTRY_RELEASE=
