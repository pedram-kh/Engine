{
  "name": "@catalyst/main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Catalyst Engine — main platform SPA (agency, brand, creator users)",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:native:dev": "vue-tsc --noEmit && vite build --mode native-development",
    "build:native": "vue-tsc --noEmit && vite build --mode native-production",
    "cap": "cap",
    "assets:sources": "node scripts/app-icon-sources.mjs",
    "assets:generate": "pnpm assets:sources && capacitor-assets generate --ios --android --assetPath assets --iconBackgroundColor '#0b0b0c' --iconBackgroundColorDark '#0b0b0c' --splashBackgroundColor '#0b0b0c' --splashBackgroundColorDark '#0b0b0c' && node scripts/app-icon-android-fixup.mjs",
    "preview": "vite preview --port 5173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@catalyst/api-client": "workspace:*",
    "@catalyst/design-tokens": "workspace:*",
    "@catalyst/ui": "workspace:*",
    "@mdi/font": "^7.4.47",
    "dompurify": "^3.4.3",
    "luxon": "3.7.2",
    "markdown-it": "^14.1.1",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0",
    "vuedraggable": "^4.1.0",
    "vuetify": "^3.7.6"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.49.1",
    "@types/dompurify": "^3.2.0",
    "@types/luxon": "3.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "sharp": "0.32.6",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
