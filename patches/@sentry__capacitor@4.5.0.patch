+        // AH-121 C3 (Catalyst patch, patches/@sentry__capacitor@4.5.0.patch): this plugin does not
+        // pass these options through from JS (its FilterNativeOptions allow-list drops them, and
+        // createOptions does not read them), so sentry-cocoa's defaults stayed ON: native HTTP
+        // breadcrumbs (URLs, sizes), lifecycle/device breadcrumbs and session tracking, none of
+        // which pass the JS scrubber. They are set off here, after everything above, so nothing
+        // can switch them back on. Session replay stays at its default rates of 0 (inert).
+        // On an upgrade, compare sdk.integrations and the breadcrumb categories of one native
+        // crash (docs/runbooks/native-sentry.md).
+        options.enableAutoSessionTracking = false
+        options.enableNetworkBreadcrumbs = false
+        options.enableNetworkTracking = false
+        options.enableCaptureFailedRequests = false
+        options.enableAutoBreadcrumbTracking = false
+        options.enableMetrics = false
+        options.sessionReplay.sessionSampleRate = 0
+        options.sessionReplay.onErrorSampleRate = 0
+
         return options
     }
 
