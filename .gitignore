# Dependencies
node_modules/
vendor/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# Coverage
coverage/
*.lcov
.nyc_output/

# Test artifacts
playwright-report/
test-results/
.playwright/

# Environment
.env
.env.local
.env.*.local
!.env.example
# The creator app's production API target is supplied locally, never committed.
# (Native build artefacts are ignored by Capacitor's own ios/ and android/
# .gitignore files.)
apps/main/.env.native-production

# Netlify's headers file starts with an underscore; a global `_*` ignore (common in
# personal gitignores) would silently hide it. AH-103b serves the iOS association file
# with it, so it must always be tracked.
!apps/main/public/_headers

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.DS_Store
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Laravel
apps/api/storage/*.key
apps/api/storage/app/public/*
!apps/api/storage/app/public/.gitkeep
apps/api/storage/framework/cache/data/*
!apps/api/storage/framework/cache/data/.gitkeep
apps/api/storage/framework/sessions/*
!apps/api/storage/framework/sessions/.gitkeep
apps/api/storage/framework/views/*
!apps/api/storage/framework/views/.gitkeep
apps/api/storage/logs/*
!apps/api/storage/logs/.gitkeep
apps/api/bootstrap/cache/*
!apps/api/bootstrap/cache/.gitkeep
apps/api/public/hot
apps/api/public/storage
apps/api/public/build/
apps/api/Homestead.json
apps/api/Homestead.yaml
apps/api/auth.json
apps/api/.phpunit.cache
apps/api/.phpunit.result.cache

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
.terraform/
.terraform.lock.hcl
crash.log
crash.*.log

# Docker
docker-compose.override.yml

# Husky
.husky/_/

# Push notifications (AH-102) — credentials that must never be committed.
# The Firebase service-account key (downloaded from the console as
# `<project>-firebase-adminsdk-*.json`) reaches the app only as the base64 env
# var FCM_SERVICE_ACCOUNT_JSON_B64. The APNs auth key is a `.p8` file.
# NOT ignored on purpose: google-services.json / GoogleService-Info.plist
# (client config, committed per the AH-102 plan, Q14).
*-firebase-adminsdk-*.json
**/service-account*.json
**/*serviceAccount*.json
**/*service_account*.json
AuthKey_*.p8
*.p8
